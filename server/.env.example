# Base de datos PostgreSQL (Render / Supabase / Neon / Local)
DATABASE_URL="postgresql://usuario:password@host:5432/inventariotec?schema=public"

# JWT Autenticación (Secreto de al menos 16 caracteres)
JWT_SECRET="reemplazar_con_un_secreto_seguro_y_aleatorio"
JWT_EXPIRES_IN="1d"

# Servidor HTTP (Render asigna el puerto en process.env.PORT)
PORT=3000
NODE_ENV=production

# Configuración de Logs
LOG_LEVEL=info

# Encriptación de contraseñas
BCRYPT_ROUNDS=12

# Configuración de CORS para el Frontend (Vercel)
# FRONTEND_URL define la URL exacta de tu frontend en producción (ej. https://inventario-tec.vercel.app)
FRONTEND_URL=https://tu-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173
